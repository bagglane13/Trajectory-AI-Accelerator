# Основной запуск: START.bat в общей папке автоматически задаёт локальную модель.
# При ручном запуске настройте уже запущенный сервер Ollama.
AI_MODE=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Без DATABASE_URL используется локальный файл data/accelerator.db.
# DATABASE_URL=sqlite:///data/accelerator.db
SECURE_COOKIE=false

# Дополнительные адаптеры моделей для ручной настройки через connect-ai.bat.
YANDEX_API_KEY=
YANDEX_MODEL=
YANDEX_URL=https://ai.api.cloud.yandex.net/foundationModels/v1/completion
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
